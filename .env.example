# ── Application Database ───────────────────────────────────────────────────────
POSTGRES_DB=rosetta
POSTGRES_USER=rosetta
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Keycloak Identity Provider ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Keycloak's own PostgreSQL database (separate from the app DB)
KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=CHANGE_ME_kc_db_password

# ── OIDC (Backend BFF) ─────────────────────────────────────────────────────────
# Client ID must match the clientId in keycloak/realm-export.json
OIDC_CLIENT_ID=rosetta-bff

# Client secret — copy from Keycloak admin UI after import, or set in realm-export.json
OIDC_CLIENT_SECRET=CHANGE_ME_copy_from_keycloak_client

# External issuer URL (what Keycloak advertises, what tokens say)
# Dev:  http://localhost:8080/realms/rosetta
# Prod: https://auth.yourdomain.com/realms/rosetta
OIDC_ISSUER=http://localhost:8080/realms/rosetta

# Internal issuer URL for backend→Keycloak calls inside Docker network
# Dev:  http://keycloak:8080/realms/rosetta
# Prod: same as OIDC_ISSUER (single domain)
OIDC_ISSUER_INTERNAL=http://keycloak:8080/realms/rosetta

# ── Session & Cookie Secrets ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be at least 32 bytes
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Pre-auth cookie HMAC signing key (gorilla/securecookie)
# Generate with: openssl rand -hex 32
COOKIE_HASH_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Pre-auth cookie AES-256 encryption key — must be exactly 32 bytes
# Generate with: openssl rand -hex 16  (16 hex bytes = 32 ASCII chars)
COOKIE_ENCRYPT_KEY=CHANGE_ME_exactly_32_bytes_aes256_

# ── Cap CAPTCHA ────────────────────────────────────────────────────────────────
# Dashboard password — at least 32 chars
CAP_ADMIN_KEY=CHANGE_ME_at_least_32_chars_for_cap_dashboard

# Dev: compose.dev.yml routes CAP_API_URL to cap-mock, which always returns
# {success:true}. CAP_SECRET_KEY is sent but ignored by the mock.
# Prod: point CAP_API_URL at the real Cap server and paste the Site/Secret keys.
CAP_SECRET_KEY=CHANGE_ME_copy_secret_key_from_cap_dashboard
VITE_CAP_SITE_KEY=CHANGE_ME_copy_site_key_from_cap_dashboard

# ── Google Cloud TTS ──────────────────────────────────────────────────────────
# Place credentials/google-service-account.json (grant roles/texttospeech.user).
# Leave unset to disable TTS (backend and migrate start normally without it).
# GOOGLE_TTS_VOICE=de-DE-Neural2-F
# AUDIO_DIR=/app/resources/audio
# AUDIO_BASE_URL=/static/audio/    # in production: set to GCS public bucket URL
# VALKEY_ADDR=valkey:6379

# ── Production Only ────────────────────────────────────────────────────────────
# DOMAIN=app.example.com
