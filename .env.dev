# Dev environment — committed, non-production values only
# Copy this to .env and adjust if needed, or use directly with:
#   docker compose -f compose.dev.yml --env-file .env.dev up

# ── Application Database ───────────────────────────────────────────────────────
POSTGRES_DB=rosetta
POSTGRES_USER=rosetta
POSTGRES_PASSWORD=rosetta-dev-db-pass

# ── Keycloak Identity Provider ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=rosetta-dev-kc-db-pass

# ── OIDC ───────────────────────────────────────────────────────────────────────
OIDC_CLIENT_ID=rosetta-bff
# Must match the secret in keycloak/realm-export.json
OIDC_CLIENT_SECRET=rosetta-dev-bff-secret-000000000000

OIDC_ISSUER=http://localhost:8080/realms/rosetta
OIDC_ISSUER_INTERNAL=http://keycloak:8080/realms/rosetta

# ── Session & Cookie Secrets (dev only — change in production!) ────────────────
SESSION_SECRET=dev-session-secret-change-in-prod00
COOKIE_HASH_KEY=dev-cookie-hash-key-change-in-prod
COOKIE_ENCRYPT_KEY=dev-encr-key-change-prod00000000

# ── Cap CAPTCHA ────────────────────────────────────────────────────────────────
# Dashboard password — must be at least 32 chars
CAP_ADMIN_KEY=dev-cap-admin-key-change-in-production0
# The cap-mock service in compose.dev.yml intercepts /siteverify and always
# returns {success:true}. CAP_SECRET_KEY is forwarded to the mock but ignored;
# any non-empty placeholder works. VITE_CAP_SITE_KEY=dev-bypass hides the widget.
CAP_SECRET_KEY=not-used-by-cap-mock
VITE_CAP_SITE_KEY=not-used-in-dev
